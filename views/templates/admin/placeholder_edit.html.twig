{# Treść zastępnika zablokowanej ramki. #}
{% extends '@Modules/quince_cmp/views/templates/admin/layout.html.twig' %}
{% import '@Modules/quince_cmp/views/templates/admin/_macros/icons.html.twig' as icons %}
{% import '@Modules/quince_cmp/views/templates/admin/_macros/fields.html.twig' as fields %}

{% trans_default_domain 'Modules.Quincecmp.Admin' %}

{% block quince_body %}
<div class="qc-screen">

    <div style="margin-bottom:18px">
        <a href="{{ path('quince_cmp_scripts') }}"
           style="display:inline-block;font-size:var(--text-xs);font-weight:var(--weight-semibold);color:var(--fg-2);margin-bottom:6px">
            {{ '← Back to scripts'|trans }}
        </a>
        <div class="qc-head-title" style="font-size:20px">{{ 'Blocked-content placeholder'|trans }}</div>
        <div class="qc-head-desc" style="max-width:640px">
            {{ 'What the visitor reads in place of a map, a video or a chat window that is held back until consent.'|trans }}
        </div>
    </div>

    <div style="display:grid;grid-template-columns:1.3fr 1fr;gap:20px;align-items:start">

        <form method="post" action="{{ path('quince_cmp_placeholder_save') }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('quince_cmp_placeholder_save') }}">
            <div class="qc-grid" style="padding:18px">
                {{ fields.multilang('ph_title', 'Heading'|trans, languages, title,
                    '', 'One line above the explanation.'|trans) }}

                {{ fields.multilangArea('ph_body', 'Explanation'|trans, languages, body,
                    '', 'Use %category% for the name of the consent that releases the content, and %provider% for the service.'|trans, 4) }}

                {{ fields.multilang('ph_allow', 'Allow button'|trans, languages, allow,
                    '', 'Loads this one frame without changing the visitor’s settings.'|trans) }}

                {{ fields.multilang('ph_settings', 'Settings button'|trans, languages, settings,
                    '', 'Opens the second layer of the banner.'|trans) }}
            </div>

            <div class="qc-actions">
                <button type="submit" class="qc-btn qc-btn-primary">
                    {{ icons.icon('check', 14) }} {{ 'Save'|trans }}
                </button>
            </div>
        </form>

        {# --- podgląd --- #}
        <div>
            <div style="font-size:11px;font-weight:var(--weight-semibold);color:var(--fg-3);text-transform:uppercase;margin-bottom:8px">
                {{ 'Preview'|trans }}
            </div>

            <div style="border:1px dashed var(--border-strong);border-radius:var(--radius-lg);background:var(--surface-sunken);padding:28px 20px;text-align:center">
                <div style="color:var(--fg-3);margin-bottom:10px">{{ icons.icon('eye', 28) }}</div>

                <div style="font-size:var(--text-sm);font-weight:var(--weight-bold);margin-bottom:6px">
                    {{ preview.title ?: 'This content is blocked'|trans }}
                </div>

                <div style="font-size:var(--text-xs);color:var(--fg-2);margin-bottom:14px">
                    {{ preview.body ?: 'It comes from %provider% and needs your consent for %category% cookies.'|trans }}
                </div>

                <div class="qc-hstack" style="gap:8px;justify-content:center">
                    <span class="qc-btn qc-btn-sm qc-btn-primary">{{ preview.allow ?: 'Show this content'|trans }}</span>
                    <span class="qc-btn qc-btn-sm qc-btn-outline">{{ preview.settings ?: 'Consent settings'|trans }}</span>
                </div>
            </div>

            <div class="qc-hint" style="margin-top:10px">
                {{ 'The wording is stored now; the storefront starts rendering it together with the banner.'|trans }}
            </div>
        </div>
    </div>

</div>
{% endblock %}

{% block quince_actionbar %}{% endblock %}

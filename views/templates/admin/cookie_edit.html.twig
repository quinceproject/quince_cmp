{# Ciasteczko: dodanie albo edycja. Osobny ekran, poza listą. #}
{% extends '@Modules/quince_cmp/views/templates/admin/layout.html.twig' %}
{% import '@Modules/quince_cmp/views/templates/admin/_macros/icons.html.twig' as icons %}
{% import '@Modules/quince_cmp/views/templates/admin/_macros/fields.html.twig' as fields %}

{% trans_default_domain 'Modules.Quincecmp.Admin' %}

{% block quince_body %}
<div class="qc-screen">

    <div style="margin-bottom:18px">
        <a href="{{ path('quince_cmp_cookies') }}"
           style="display:inline-block;font-size:var(--text-xs);font-weight:var(--weight-semibold);color:var(--fg-2);margin-bottom:6px">
            {{ '← Back to cookies'|trans }}
        </a>
        <div class="qc-hstack" style="gap:10px">
            <div class="qc-head-title" style="font-size:20px">
                {{ cookie ? cookie.name : 'New cookie'|trans }}
            </div>
            {% if cookie %}
                <span class="qc-badge">{{ cookie.source }}</span>
            {% endif %}
        </div>
        <div class="qc-head-desc">
            {{ 'What the customer reads about this cookie in the second layer of the banner.'|trans }}
        </div>
    </div>

    <form method="post" action="{{ path('quince_cmp_cookie_save') }}">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('quince_cmp_cookie_save') }}">
        <div class="qc-grid qc-formcol" style="padding:18px">
            <input type="hidden" name="id_cmp_cookie" value="{{ cookie.id_cmp_cookie|default(0) }}">

            <div class="qc-form-grid qc-form-grid-2">
                <div class="qc-field">
                    <label class="qc-label" for="name">{{ 'Name'|trans }}</label>
                    <input class="qc-field-base qc-focusable" type="text" id="name" name="name"
                           value="{{ cookie.name|default(prefillName|default('')) }}" placeholder="_ga_*" required>
                    <div class="qc-hint">{{ 'A trailing asterisk matches a family of cookies, e.g. _ga_*.'|trans }}</div>
                </div>

                <div class="qc-field">
                    <label class="qc-label" for="provider">{{ 'Provider'|trans }}</label>
                    <input class="qc-field-base qc-focusable" type="text" id="provider" name="provider"
                           value="{{ cookie.provider|default('') }}" placeholder="Google">
                </div>

                <div class="qc-field">
                    <label class="qc-label" for="category">{{ 'Category'|trans }}</label>
                    <div class="qc-select-wrap">
                        <select class="qc-field-base qc-select qc-focusable" id="category" name="category">
                            <option value="">{{ '(unassigned)'|trans }}</option>
                            {% for code, label in categories %}
                                <option value="{{ code }}" {{ cookie.category|default('') == code ? 'selected' : '' }}>
                                    {{ label|trans }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="qc-hint">{{ 'The category decides which consent switches this cookie on.'|trans }}</div>
                </div>

                <div class="qc-field">
                    <label class="qc-label" for="lifetime_value">{{ 'Lifetime'|trans }}</label>
                    <div class="qc-hstack" style="gap:8px;flex-wrap:nowrap">
                        <input class="qc-field-base qc-focusable" type="number" min="0" style="width:100px"
                               id="lifetime_value" name="lifetime_value"
                               value="{{ cookie.lifetime_value|default(0) }}">
                        <div class="qc-select-wrap" style="flex:1">
                            <select class="qc-field-base qc-select qc-focusable" name="lifetime_unit">
                                {% for unit in units %}
                                    <option value="{{ unit }}"
                                        {{ cookie.lifetime_unit|default('session') == unit ? 'selected' : '' }}>
                                        {{ unit|trans }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>
                    <div class="qc-hint">
                        {{ 'The customer reads this in their own language: the module builds the wording from the number and the unit.'|trans }}
                    </div>
                </div>
            </div>

            {{ fields.multilang('description', 'Description'|trans, languages, cookie.descriptions|default({}),
                '', 'Shown to the customer in the second layer of the banner.'|trans) }}
        </div>

        <div class="qc-actions qc-formcol">
            {% if cookie %}
                <button type="submit" form="delete-cookie" class="qc-btn qc-btn-text qc-danger-slot"
                        style="color:var(--danger)">
                    {{ icons.icon('trash', 13) }} {{ 'Delete'|trans }}
                </button>
            {% endif %}

            <a href="{{ path('quince_cmp_cookies') }}" class="qc-btn qc-btn-text">{{ 'Cancel'|trans }}</a>
            <button type="submit" class="qc-btn qc-btn-primary">
                {{ icons.icon('check', 14) }} {{ 'Save'|trans }}
            </button>
        </div>
    </form>

    {% if cookie %}
        <form id="delete-cookie" method="post" hidden
              action="{{ path('quince_cmp_cookie_delete', {'idCookie': cookie.id_cmp_cookie}) }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('quince_cmp_cookie_delete') }}">
        </form>
    {% endif %}

</div>
{% endblock %}

{% block quince_actionbar %}{% endblock %}

{# Rodzaj zgody — szczegół. Układ wg prototypy/ConsentTypeDetail.dc.html #}
{% extends '@Modules/quince_cmp/views/templates/admin/layout.html.twig' %}
{% import '@Modules/quince_cmp/views/templates/admin/_macros/icons.html.twig' as icons %}
{% import '@Modules/quince_cmp/views/templates/admin/_macros/fields.html.twig' as fields %}

{% trans_default_domain 'Modules.Quincecmp.Admin' %}

{% set vcols = '0.6fr 1.4fr 1.3fr 1fr 0.7fr 0.7fr' %}
{% set tabs = {'content': 'Content', 'history': 'Version history', 'appears': 'Where it appears'} %}

{% block quince_body %}
<div class="qc-screen">

    <div class="qc-hstack" style="gap:10px;margin-bottom:16px">
        <code style="font-family:var(--font-mono);font-size:var(--text-lg);font-weight:var(--weight-bold)">{{ type.code }}</code>
        <div style="font-size:var(--text-md)">{{ typeName }}</div>
        <span class="qc-badge">{{ kinds[type.kind]|default(type.kind)|trans }}</span>
        {% if type.required %}
            <span class="qc-badge qc-badge-danger">{{ 'Required'|trans }}</span>
        {% endif %}
        <a href="{{ path('quince_cmp_type_edit', {'idType': type.id_cmp_type, 'tab': 'content'}) }}#publish"
           class="qc-btn qc-btn-sm qc-btn-primary" style="margin-left:auto">{{ 'Publish new version'|trans }}</a>
    </div>

    <div class="qc-tabs">
        {% for key, label in tabs %}
            <a class="qc-tab {{ tab == key ? 'is-active' : '' }}"
               href="{{ path('quince_cmp_type_edit', {'idType': type.id_cmp_type, 'tab': key}) }}"
               {{ tab == key ? 'aria-current="page"' : '' }}>{{ label|trans }}</a>
        {% endfor %}
    </div>

    {# ============================ CONTENT ============================ #}
    {% if tab == 'content' %}

        {% if current %}
            <div class="qc-alert qc-alert-warning" style="margin-bottom:16px">
                {{ icons.message('warn', 18, 'qc-alert-icon') }}
                <div>{{ 'A published version cannot be edited. Editing would invalidate the proof for %count% collected consents. Publish a new version instead.'|trans({'%count%': collectedCurrent}) }}</div>
            </div>
        {% endif %}

        <div style="display:grid;grid-template-columns:1.3fr 1fr;gap:20px;margin-bottom:24px">
            <div>
                {{ fields.multilang('current_short_label', 'Short label'|trans, languages, currentLabels, '', '', '', true) }}

                {% if type.kind == 'document' %}
                    <div class="qc-field">
                        <label class="qc-label">{{ 'Full clause'|trans }}</label>
                        <div style="min-height:80px;border:1px solid var(--border);border-radius:var(--radius-md);background:var(--surface-sunken);padding:10px 12px;font-size:var(--text-xs);color:var(--fg-2)">
                            {{ 'The document is a CMS page of this shop.'|trans }}
                        </div>
                    </div>
                {% else %}
                    {{ fields.multilangArea('current_full_clause', 'Full clause'|trans, languages, currentClauses, '', '', 5, true) }}
                {% endif %}

                <div class="qc-field">
                    <label class="qc-label">{{ 'PDF'|trans }}</label>
                    <div style="height:36px;border:1px dashed var(--border);border-radius:var(--radius-md);background:var(--surface-sunken);padding:0 12px;display:flex;align-items:center;font-size:var(--text-xs);color:var(--fg-2)">
                        {{ currentPdf ?: '-' }}
                    </div>
                </div>
            </div>

            <div class="qc-grid" style="padding:16px;align-self:flex-start">
                <div style="font-size:11px;font-weight:var(--weight-semibold);color:var(--fg-3);text-transform:uppercase;margin-bottom:10px">
                    {{ 'Customer preview'|trans }}
                </div>
                <div style="display:flex;gap:8px;align-items:flex-start;font-size:var(--text-xs);margin-bottom:8px">
                    <span style="width:16px;height:16px;border:1.5px solid var(--border-strong);border-radius:4px;flex:none;margin-top:1px"></span>
                    <div>{{ currentLabelHtml|raw ?: 'Nothing published yet.'|trans }}</div>
                </div>
                {% if current and (current.full_clause or type.kind == 'document') %}
                    <div style="font-size:var(--text-xs);font-weight:var(--weight-semibold);color:var(--accent-active);margin-left:24px">
                        {{ 'Read the full clause'|trans }} {{ icons.icon('chevronDown', 12) }}
                    </div>
                {% endif %}
            </div>
        </div>

        {# --- wydanie nowej wersji --- #}
        <form id="publish" method="post" enctype="multipart/form-data"
              action="{{ path('quince_cmp_type_publish', {'idType': type.id_cmp_type}) }}" x-data="{ plik: '' }">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('quince_cmp_type_publish') }}">
            <div class="qc-formcol" style="border:1px solid var(--accent-soft-border);border-radius:var(--radius-lg);background:var(--surface);padding:18px">
                <div style="font-size:var(--text-sm);font-weight:var(--weight-bold);margin-bottom:12px">{{ 'Publish new version'|trans }}</div>

                <div style="font-size:11px;font-weight:var(--weight-semibold);color:var(--fg-3);margin-bottom:6px">
                    {{ 'Version number'|trans }}
                    <span style="font-weight:var(--weight-regular);font-style:italic">{{ '(open decision, SPEC §10.5)'|trans }}</span>
                </div>

                <div style="display:flex;gap:10px;margin-bottom:14px">
                    <label style="flex:1;border:1px solid var(--border);border-radius:var(--radius-md);padding:10px 12px;cursor:pointer">
                        <span style="display:flex;align-items:center;gap:6px;font-size:var(--text-xs);font-weight:var(--weight-semibold);margin-bottom:6px">
                            <input type="radio" name="numbering" value="manual"> {{ 'Number from the external register'|trans }}
                        </span>
                        <input class="qc-field-base qc-field-sm qc-focusable" type="text" name="version"
                               placeholder="{{ 'e.g. %v%'|trans({'%v%': nextVersion}) }}">
                    </label>

                    <label style="flex:1;border:1.5px solid var(--accent);border-radius:var(--radius-md);padding:10px 12px;background:var(--accent-soft);cursor:pointer">
                        <span style="display:flex;align-items:center;gap:6px;font-size:var(--text-xs);font-weight:var(--weight-semibold);margin-bottom:6px">
                            <input type="radio" name="numbering" value="auto" checked> {{ 'Next number automatically'|trans }}
                        </span>
                        <span style="height:32px;border:1px solid var(--border);border-radius:var(--radius-md);padding:0 10px;display:flex;align-items:center;font-size:var(--text-xs);font-weight:var(--weight-semibold);background:var(--surface)">
                            {{ nextVersion }}
                        </span>
                    </label>
                </div>

                {# Dokument dołączony do wersji jest alternatywą dla strony CMS.
                   Strona zmienia się w miejscu, plik zostaje zamrożony w kształcie
                   z chwili wydania — a dowód ma pokazywać treść z tamtej chwili. #}
                <div class="qc-field" style="margin-bottom:14px">
                    <label class="qc-label" for="pdf">{{ 'Attach the document as PDF'|trans }}</label>
                    <div class="qc-hstack" style="gap:10px">
                        <label class="qc-btn qc-btn-sm qc-btn-outline" style="margin:0">
                            {{ icons.icon('folder', 13) }} {{ 'Choose a file'|trans }}
                            <input type="file" id="pdf" name="pdf" accept="application/pdf,.pdf"
                                   style="position:absolute;opacity:0;width:0;height:0"
                                   @change="plik = $event.target.files.length ? $event.target.files[0].name : ''">
                        </label>
                        <span class="qc-mono qc-sub" x-text="plik || '{{ 'no file chosen'|trans }}'"></span>
                    </div>
                    <div class="qc-hint">
                        {% if type.kind == 'document' %}
                            {{ 'Optional when a CMS page is linked, required when it is not. Up to 10 MB.'|trans }}
                        {% else %}
                            {{ 'Optional. Use it when the wording lives outside the shop. Up to 10 MB.'|trans }}
                        {% endif %}
                    </div>
                </div>

                {{ fields.multilang('short_label', 'Short label'|trans, languages, {}, '',
                    'Link a document with [text](cms:3).'|trans) }}

                {% if type.kind != 'document' %}
                    {{ fields.multilangArea('full_clause', 'Full clause'|trans, languages, {}, '',
                        'Optional. Shown when the customer expands the label.'|trans, 4) }}
                {% endif %}

                <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:12px 0">
                    <div>
                        <div style="font-size:11px;font-weight:var(--weight-semibold);color:var(--fg-3);margin-bottom:4px">{{ 'In force from'|trans }}</div>
                        <input class="qc-field-base qc-focusable" type="date" name="date_from" style="width:100%">
                    </div>
                    <div>
                        <div style="font-size:11px;font-weight:var(--weight-semibold);color:var(--fg-3);margin-bottom:4px">{{ 'Text hash of new content'|trans }}</div>
                        <div style="height:36px;border:1px solid var(--border);border-radius:var(--radius-md);padding:0 12px;display:flex;align-items:center;font-family:var(--font-mono);font-size:12px;color:var(--fg-2);background:var(--surface-sunken)">
                            {{ 'computed on save'|trans }}
                        </div>
                    </div>
                </div>

                {% if current %}
                    <div style="font-size:var(--text-xs);color:var(--fg-2);margin-bottom:12px">
                        {{ '%v% stays in the table as proof for the %count% consents already collected under it.'|trans({
                            '%v%': current.version, '%count%': collectedCurrent}) }}
                    </div>
                {% endif %}

                <div class="qc-actions">
                    <button type="submit" class="qc-btn qc-btn-primary">{{ 'Publish new version'|trans }}</button>
                </div>
            </div>
        </form>

    {# ======================== VERSION HISTORY ======================== #}
    {% elseif tab == 'history' %}

        <div class="qc-grid">
            <div class="qc-grid-head" style="display:grid;grid-template-columns:{{ vcols }};gap:8px;font-size:11px;padding:10px 14px">
                <div>{{ 'Version'|trans }}</div>
                <div>{{ 'In force'|trans }}</div>
                <div>{{ 'Text hash'|trans }}</div>
                <div>{{ 'Collected'|trans }}</div>
                <div>{{ 'PDF'|trans }}</div>
                <div></div>
            </div>

            {% for version in versions %}
                <div x-data="{ open: false }">
                    <div class="qc-grid-row" style="display:grid;grid-template-columns:{{ vcols }};gap:8px;padding:11px 14px">
                        <div style="font-size:var(--text-sm);font-weight:var(--weight-bold)">{{ version.version }}</div>
                        <div style="font-size:var(--text-xs);color:var(--fg-2)">
                            {{ version.date_from|slice(0, 10) }} → {{ version.date_to ? version.date_to|slice(0, 10) : 'present'|trans }}
                        </div>
                        {# Skrót jest dowodem na treść, więc stoi w całości. Ucięty
                           do dziesięciu znaków nie pozwala niczego zweryfikować. #}
                        <div class="qc-mono" style="color:var(--fg-2);font-size:10px;line-height:1.5;word-break:break-all">
                            {% for hash in version.hashes %}
                                <div><span style="color:var(--fg-3)">{{ hash.iso }}</span> {{ hash.hash }}</div>
                            {% else %}
                                -
                            {% endfor %}
                        </div>
                        <div style="font-size:var(--text-xs)">{{ version.collected }}</div>
                        <div style="font-size:var(--text-xs)">
                            {% if version.pdf %}
                                <a class="qc-linkbtn" href="{{ documentUrl }}{{ version.id_cmp_version }}" target="_blank" rel="noopener">
                                    {{ 'Open PDF'|trans }}
                                </a>
                            {% else %}
                                <span style="color:var(--fg-3)">-</span>
                            {% endif %}
                        </div>
                        <button type="button" class="qc-linkbtn" style="justify-self:end" @click="open = !open">
                            <span x-text="open ? '{{ 'Hide text'|trans }}' : '{{ 'View text'|trans }}'"></span>
                        </button>
                    </div>

                    <div x-show="open" x-cloak style="padding:0 14px 14px;display:grid;gap:16px">
                        {% for hash in version.hashes %}
                            <div style="padding:10px 12px;background:var(--surface-sunken);border-radius:var(--radius-md)">
                                <div style="font-size:10px;font-weight:var(--weight-semibold);color:var(--fg-3);text-transform:uppercase;margin-bottom:4px">
                                    {{ hash.iso }}
                                </div>
                                <div style="font-size:var(--text-xs);font-weight:var(--weight-semibold);margin-bottom:4px">
                                    {{ hash.short_label|default('-') }}
                                </div>
                                {% if hash.full_clause %}
                                    <div style="font-size:var(--text-xs);color:var(--fg-2);white-space:pre-wrap">{{ hash.full_clause }}</div>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% else %}
                <div class="qc-empty" style="padding:24px 20px">
                    <div class="qc-empty-text">{{ 'No version published yet.'|trans }}</div>
                </div>
            {% endfor %}
        </div>

    {# ======================== WHERE IT APPEARS ======================== #}
    {% else %}

        <form method="post" action="{{ path('quince_cmp_type_save', {'idType': type.id_cmp_type}) }}" class="qc-stack">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('quince_cmp_type_save') }}">

            {% if type.kind == 'document' %}
                <div class="qc-grid" style="padding:16px 18px">
                    <div class="qc-field">
                        <label class="qc-label" for="id_cms">{{ 'Document page'|trans }}</label>
                        <div class="qc-select-wrap">
                            <select class="qc-field-base qc-select qc-focusable" id="id_cms" name="id_cms">
                                <option value="0">{{ '(not linked)'|trans }}</option>
                                {% for page in cmsPages %}
                                    <option value="{{ page.id_cms }}" {{ type.id_cms == page.id_cms ? 'selected' : '' }}>{{ page.title }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="qc-hint">{{ 'Edit the wording in Design → Pages. This module links to it, it does not store it.'|trans }}</div>
                    </div>
                </div>
            {% endif %}

            <div class="qc-grid" style="padding:16px 18px">
                {% if isNative %}
                    <div class="qc-field">
                        <div class="qc-hstack" style="gap:8px">
                            <span style="font-size:var(--text-sm);font-weight:var(--weight-semibold)">{{ 'Shown natively'|trans }}</span>
                            <span class="qc-badge qc-badge-accent">{{ 'native checkbox'|trans }}</span>
                        </div>
                        <div class="qc-hint">{{ 'A native PrestaShop mechanism already shows this to the customer. The module does not add its own checkbox here, and does not touch that field\'s own wording. Edit it on its own settings screen.'|trans }}</div>
                    </div>
                {% endif %}

                <div class="qc-field">
                    <label class="qc-label" for="core_field">{{ 'Mirror in customer account'|trans }}</label>
                    <div class="qc-select-wrap">
                        <select class="qc-field-base qc-select qc-focusable" id="core_field" name="core_field">
                            <option value="">{{ '(not mirrored)'|trans }}</option>
                            {% for value, label in coreFields %}
                                <option value="{{ value }}" {{ type.core_field == value ? 'selected' : '' }}>{{ label|trans }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="qc-hint">{{ 'Optional. PrestaShop keeps the current state in this column, we keep the history. One consent per column: picking one already used elsewhere is refused.'|trans }}</div>
                </div>

                {% if not isNative %}
                    <div class="qc-field">
                        {{ fields.toggle('show_in_checkout', type.show_in_checkout, 'Show in checkout'|trans) }}
                        <div class="qc-hint">{{ 'The customer must accept this consent before placing an order. Off by default for a new consent: switch it on only for the ones that belong in checkout.'|trans }}</div>
                    </div>
                {% endif %}

                <div class="qc-actions">
                    <button type="submit" class="qc-btn qc-btn-primary">{{ icons.icon('check', 14) }} {{ 'Save'|trans }}</button>
                </div>
            </div>

            <div class="qc-grid">
                <div style="padding:14px 18px;border-bottom:1px solid var(--border);font-size:var(--text-sm);font-weight:var(--weight-bold)">
                    {{ 'Where this consent is asked'|trans }}
                </div>

                {% for place in appears %}
                    <div style="padding:12px 18px;{{ not loop.last ? 'border-bottom:1px solid var(--border)' : '' }}">
                        <div class="qc-hstack" style="gap:8px">
                            <span style="font-size:var(--text-sm);font-weight:var(--weight-semibold)">{{ place.where|trans }}</span>
                            {% if not place.native %}
                                <span class="qc-badge qc-badge-warning">{{ 'not built yet'|trans }}</span>
                            {% endif %}
                        </div>
                        <div style="font-size:var(--text-xs);color:var(--fg-2);margin-top:2px">{{ place.how|trans }}</div>
                    </div>
                {% else %}
                    <div class="qc-empty" style="padding:24px 20px">
                        <div class="qc-empty-text">{{ 'This consent is not wired to any place in the shop yet.'|trans }}</div>
                    </div>
                {% endfor %}
            </div>
        </form>

    {% endif %}

</div>
{% endblock %}

{% block quince_actionbar %}{% endblock %}

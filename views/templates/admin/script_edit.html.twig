{# Usługa — dodanie albo edycja. Osobny ekran, poza listą. #}
{% extends '@Modules/quince_cmp/views/templates/admin/layout.html.twig' %}
{% import '@Modules/quince_cmp/views/templates/admin/_macros/icons.html.twig' as icons %}

{% trans_default_domain 'Modules.Quincecmp.Admin' %}

{% block quince_body %}
<div class="qc-screen">

    <div style="margin-bottom:18px">
        <a href="{{ path('quince_cmp_scripts') }}"
           style="display:inline-block;font-size:var(--text-xs);font-weight:var(--weight-semibold);color:var(--fg-2);margin-bottom:6px">
            {{ '← Back to scripts'|trans }}
        </a>
        <div class="qc-head-title" style="font-size:20px">
            {{ script ? script.name : 'New service'|trans }}
        </div>
        <div class="qc-head-desc">
            {{ 'How this service is embedded, which consent it waits for and how it is held back.'|trans }}
        </div>
    </div>

    <form method="post" action="{{ path('quince_cmp_script_save') }}">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('quince_cmp_script_save') }}">
        <div class="qc-grid qc-formcol" style="padding:18px">
            <input type="hidden" name="id_cmp_script" value="{{ script.id_cmp_script|default(0) }}">

            <div class="qc-form-grid qc-form-grid-2">
                <div class="qc-field">
                    <label class="qc-label" for="name">{{ 'Name'|trans }}</label>
                    <input class="qc-field-base qc-focusable" type="text" id="name" name="name"
                           value="{{ script.name|default('') }}" placeholder="Google Analytics 4" required>
                </div>

                <div class="qc-field">
                    <label class="qc-label" for="category">{{ 'Category'|trans }}</label>
                    <div class="qc-select-wrap">
                        <select class="qc-field-base qc-select qc-focusable" id="category" name="category">
                            <option value="">{{ '(unassigned)'|trans }}</option>
                            {% for code, label in categories %}
                                <option value="{{ code }}" {{ script.category|default('') == code ? 'selected' : '' }}>
                                    {{ label }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="qc-hint">{{ 'The consent that releases this service.'|trans }}</div>
                </div>

                <div class="qc-field">
                    <label class="qc-label" for="embedding">{{ 'Embedding'|trans }}</label>
                    <div class="qc-select-wrap">
                        <select class="qc-field-base qc-select qc-focusable" id="embedding" name="embedding">
                            {% for value, label in embeddings %}
                                <option value="{{ value }}" {{ script.embedding|default('') == value ? 'selected' : '' }}>
                                    {{ label|trans }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="qc-hint">{{ 'How the service gets onto the page.'|trans }}</div>
                </div>

                <div class="qc-field">
                    <label class="qc-label" for="technique">{{ 'Blocking technique'|trans }}</label>
                    <div class="qc-select-wrap">
                        <select class="qc-field-base qc-select qc-focusable" id="technique" name="technique">
                            {% for value, label in techniques %}
                                <option value="{{ value }}" {{ script.technique|default('') == value ? 'selected' : '' }}>
                                    {{ label|trans }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="qc-hint">{{ 'How it is held back until consent is given.'|trans }}</div>
                </div>
            </div>

            <div class="qc-field">
                <label class="qc-label" for="pattern">{{ 'Match pattern'|trans }}</label>
                <input class="qc-field-base qc-focusable" type="text" id="pattern" name="pattern"
                       value="{{ script.pattern|default('') }}" placeholder="googletagmanager.com">
                <div class="qc-hint">
                    {{ 'Fragment of the script address or of its inline content by which the module recognises it on the page.'|trans }}
                </div>
            </div>
        </div>

        <div class="qc-actions qc-formcol">
            {% if script %}
                <button type="submit" form="delete-script" class="qc-btn qc-btn-text qc-danger-slot"
                        style="color:var(--danger)">
                    {{ icons.icon('trash', 13) }} {{ 'Delete'|trans }}
                </button>
            {% endif %}

            <a href="{{ path('quince_cmp_scripts') }}" class="qc-btn qc-btn-text">{{ 'Cancel'|trans }}</a>
            <button type="submit" class="qc-btn qc-btn-primary">
                {{ icons.icon('check', 14) }} {{ 'Save'|trans }}
            </button>
        </div>
    </form>

    {% if script %}
        <form id="delete-script" method="post" hidden
              action="{{ path('quince_cmp_script_delete', {'idScript': script.id_cmp_script}) }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('quince_cmp_script_delete') }}">
        </form>
    {% endif %}

</div>
{% endblock %}

{% block quince_actionbar %}{% endblock %}

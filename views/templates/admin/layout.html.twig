{#
  Layout bazowy panelu Quince CMP.

  Ekran podrzędny dostarcza trzy bloki: quince_intro, quince_body
  i quince_actions. Boczny pasek i powłoka są tutaj raz.

  To **własna kopia** layoutu z `quince_engine`, nie rozszerzenie go. Moduł ma
  działać w sklepie bez silnika, a `{% extends %}` z cudzego katalogu wywraca
  się przy jego braku, i to na każdej podstronie naraz.

  Językiem bazowym modułu jest angielski. Wszystkie napisy przechodzą przez
  filtr `trans` z domeną Modules.Quincecmp.Admin; tłumaczenia leżą
  w `translations/pl-PL/`.

  Zmienne od kontrolera:
    nav:         pozycje bocznego paska (Quince\Cmp\Ui\PanelNavigation)
    quinceRoute: nazwa bieżącej trasy, podświetla pozycję w pasku
    qcVersion:   wersja modułu, znacznik przy plikach CSS i JS
#}
{% extends '@PrestaShop/Admin/layout.html.twig' %}
{% import '@Modules/quince_cmp/views/templates/admin/_macros/icons.html.twig' as icons %}

{% trans_default_domain 'Modules.Quincecmp.Admin' %}

{# Znacznik wersji przy każdym pliku. Bez niego przeglądarka trzyma poprzedni
   arkusz i poprawki CSS nie docierają do panelu mimo poprawnego pliku na dysku.
   W trybie deweloperskim jest to znacznik czasu, na produkcji wersja modułu, więc cache działa aż do aktualizacji. #}
{% set qcVer = '?v=' ~ (app.debug ? 'now'|date('U') : qcVersion|default('0.1.0')) %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('../modules/quince_cmp/views/css/tokens/base.css') ~ qcVer }}">
    <link rel="stylesheet" href="{{ asset('../modules/quince_cmp/views/css/tokens/colors.css') ~ qcVer }}">
    <link rel="stylesheet" href="{{ asset('../modules/quince_cmp/views/css/tokens/typography.css') ~ qcVer }}">
    <link rel="stylesheet" href="{{ asset('../modules/quince_cmp/views/css/tokens/spacing.css') ~ qcVer }}">
    <link rel="stylesheet" href="{{ asset('../modules/quince_cmp/views/css/tokens/components.css') ~ qcVer }}">
    <link rel="stylesheet" href="{{ asset('../modules/quince_cmp/views/css/panel.css') ~ qcVer }}">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {# Alpine obsługuje pola wielojęzyczne z `_macros/fields.html.twig`.
       Własna kopia w module, nie plik silnika: moduł ma działać bez niego. #}
    {# Przechwytuje komunikaty PrestaShopa i pokazuje je jako toast. Natywne alerty
       wchodzą nad treść, przesuwają cały układ w dół i zostają do przeładowania. #}
    <script src="{{ asset('../modules/quince_cmp/views/js/panel.js') ~ qcVer }}" defer></script>
    <script src="{{ asset('../modules/quince_cmp/views/js/vendor/alpine.min.js') ~ qcVer }}" defer></script>
{% endblock %}

{% block content %}
{% set navItems = nav|default([]) %}

<div class="qc-root">
    <div class="qc-shell">

        {# Na telefonie pasek z ikonami zabiera szerokość i nie mówi, dokąd prowadzą
           pozostałe pozycje. Zastępuje go ten przycisk: nazwa bieżącej strony,
           po dotknięciu pełna lista z nazwami. Na dużym ekranie jest ukryty. #}
        {% set navCurrent = navItems|filter(i => i.route|default('') == quinceRoute|default('-'))|first %}

        <button type="button" class="qc-nav-mobile" aria-expanded="false" aria-controls="qc-sidenav">
            <span class="qc-nav-label">{{ navCurrent.label|default(layoutTitle|default('Quince CMP'))|trans }}</span>
            <svg class="qc-nav-mobile-arrow" width="14" height="14" viewBox="0 0 16 16" fill="none"
                 stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m4 6 4 4 4-4"/></svg>
        </button>

        <nav class="qc-sidenav" id="qc-sidenav" aria-label="Quince CMP">
            {% for item in navItems %}
                {% if item.route is defined %}
                    <a href="{{ path(item.route) }}"
                       class="qc-nav-item{{ quinceRoute|default('') == item.route ? ' qc-active' : '' }}">
                        {{ icons.icon(item.icon) }}
                        <span class="qc-nav-label">{{ item.label|trans }}</span>
                    </a>
                {% else %}
                    {# Pozycja zaplanowana, ale jeszcze niezbudowana. Wyszarzona
                       ze znacznikiem, żeby było widać, że to docelowe miejsce,
                       a nie zepsuty odnośnik. #}
                    <span class="qc-nav-item qc-disabled" aria-disabled="true">
                        {{ icons.icon(item.icon) }}
                        <span class="qc-nav-label">{{ item.label|trans }}</span>
                        <span class="qc-nav-soon">{{ 'soon'|trans }}</span>
                    </span>
                {% endif %}
            {% endfor %}


        </nav>

        <div class="qc-content">
            {# Tytuł strony rysuje PrestaShop (breadcrumb + nagłówek), więc go nie
               powtarzamy. Zostaje krótka informacja, co da się na tym widoku zrobić. #}
            {% block quince_intro %}{% endblock %}

            {% block quince_body %}{% endblock %}

            {# Dwie rzeczy naraz, bo dają co innego. Blok `quince_actionbar` pozwala
               ekranowi świadomie zgasić pasek albo podmienić go na własny.
               Sprawdzenie pustki gwarantuje, że pusty pasek nie wyjdzie nawet
               wtedy, gdy ktoś o bloku zapomni (przyklejony do dna okna wygląda
               na niedokończony formularz).

               Postać i nazwa bloku są takie same jak w layoucie silnika
               i powinny takie zostać. #}
            {% block quince_actionbar %}
                {% set qcAkcje %}{% block quince_actions %}{% endblock %}{% endset %}
                {% set qcAkcjeInfo %}{% block quince_actions_info %}{% endblock %}{% endset %}

                {% if qcAkcje|trim is not empty or qcAkcjeInfo|trim is not empty %}
                    <div class="qc-actionbar">
                        <div class="qc-actionbar-info">{{ qcAkcjeInfo }}</div>
                        {{ qcAkcje }}
                    </div>
                {% endif %}
            {% endblock %}
        </div>

    </div>
</div>
{% endblock %}
